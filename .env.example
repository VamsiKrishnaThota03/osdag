# Copy to .env (never commit .env) and fill in the values.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL (DB_PASSWORD is required)
DB_NAME=postgres_Intg_osdag
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Set to "sqlite" only for quick local checks without PostgreSQL
# (the steel section tables are not loaded in that case).
# DB_ENGINE=sqlite
